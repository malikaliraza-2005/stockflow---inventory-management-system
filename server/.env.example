# ims-server environment inventory (SRS §18.4 · NFR-28 · DEP §7)
# Names + purpose ONLY — real values live in local .env (dev) or the platform
# secret manager (staging/prod, SEC-10). Boot aborts naming any missing or
# invalid variable (src/config/env.ts).

# --- Runtime ---
NODE_ENV=                       # development | test | staging | production
PORT=                           # bind port (default 3000)

# --- Database ---
MONGODB_URI=                    # Atlas SRV string, least-privilege user (SEC-11)

# --- Auth secrets (SEC-01: >= 32 chars / 256-bit, per-environment, distinct) ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=               # e.g. 15m (default 15m)
REFRESH_TOKEN_TTL=              # e.g. 7d (default 7d)

# --- Google sign-in (AAD) — OAuth 2.0 Web client id; optional ---
GOOGLE_CLIENT_ID=               # …apps.googleusercontent.com; absent ⇒ POST /auth/google returns "not available"

# --- HTTP ---
CORS_ORIGIN=                    # exact frontend origin for this environment (DEP §8)
TRUST_PROXY_HOPS=               # exact platform proxy hop count, verified per env (ARB-01/R-4); default 0

# --- Cloudinary (SEC-08) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_DELIVERY_HOST=       # image-URL host pin (VAL Issue 4); default res.cloudinary.com

# --- Seed bootstrap (FR-USER-06) — rotate after first login ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Rate limiting (SEC-04) — defaults: global 300 / 15 min, strict 10 / 15 min ---
RATE_LIMIT_GLOBAL_MAX=
RATE_LIMIT_GLOBAL_WINDOW_MS=
RATE_LIMIT_STRICT_MAX=
RATE_LIMIT_STRICT_WINDOW_MS=

# --- Search (D-1 / R-6) ---
ATLAS_SEARCH_ENABLED=           # true only where the tier has Atlas Search (staging/prod); default false → regex fallback

# --- AI Inventory Assistant (read-only chat) — ships dark ---
CHAT_ENABLED=                   # true enables POST /api/v1/chat and the client entry point; default false
LLM_PROVIDER=                   # fake | gemini; default fake. `fake` is REJECTED when CHAT_ENABLED=true in staging/production
LLM_MODEL=                      # default gemini-2.5-flash
LLM_API_KEY=                    # SECRET — required when CHAT_ENABLED=true with a real provider. NEVER VITE_-prefixed
LLM_MAX_TOKENS=                 # default 256 (the output is one small JSON object)
LLM_TIMEOUT_MS=                 # default 8000 — drives the AbortSignal on every LLM call
RATE_LIMIT_CHAT_MAX=            # default 30 per window, keyed on the USER not the IP
RATE_LIMIT_CHAT_WINDOW_MS=      # default 900000

# --- Observability ---
LOG_LEVEL=                      # fatal | error | warn | info | debug | trace (default info)
SENTRY_DSN=                     # error-tracker DSN (NFR-23); optional
